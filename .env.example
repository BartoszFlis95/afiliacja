# ─────────────────────────────────────────────────────────────
# Auth (Auth.js v5)
# ─────────────────────────────────────────────────────────────
# Sekret do podpisywania/szyfrowania tokenów sesji (JWT).
# Wygeneruj losowy ciąg jedną z komend:
#   npx auth secret
#   openssl rand -base64 32
# Nigdy nie commituj prawdziwej wartości do repo.
AUTH_SECRET=your_secret_here

# Publiczny URL aplikacji — używany przez callbacki OAuth.
# Lokalnie: http://localhost:3000
AUTH_URL=https://www.deneeu.pl

# Wymagane, gdy aplikacja stoi za proxy (Vercel) — Auth.js ufa nagłówkom hosta.
AUTH_TRUST_HOST=true

# ─────────────────────────────────────────────────────────────
# Database — Neon PostgreSQL
# ─────────────────────────────────────────────────────────────
# 1. Załóż projekt na https://neon.tech
# 2. Dashboard → Connection Details → skopiuj "Connection string" (Pooled).
# 3. Upewnij się, że na końcu jest ?sslmode=require — Neon wymaga SSL.
# Wskazówka: do Prisma migrate użyj połączenia bez poolera (Direct),
# a do runtime'u połączenia z poolerem (-pooler w hoście).
# connect_timeout / pool_timeout są ważne dla Neon — baza "usypia" (autosuspend)
# po bezczynności i budzi się kilka sekund, bez tego Prisma dostaje
# "Error in PostgreSQL connection: Error { kind: Closed, cause: None }".
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/dbname?sslmode=require&pgbouncer=true&connect_timeout=15&pool_timeout=15

# Połączenie bezpośrednie (bez poolera) — używane tylko przez `prisma migrate`.
DIRECT_URL=postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/dbname?sslmode=require&connect_timeout=15

# ─────────────────────────────────────────────────────────────
# Cloudflare R2 — przesyłanie zdjęć produktów, avatarów i logotypów
# ─────────────────────────────────────────────────────────────
# 1. Załóż bucket w Cloudflare Dashboard → R2.
# 2. Włącz publiczny dostęp (Public Development URL lub własna domena).
# 3. Utwórz token API R2 z uprawnieniami Object Read & Write dla tego bucketa.
CLOUDFLARE_R2_ACCOUNT_ID=your_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=your_access_key
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_secret_key
CLOUDFLARE_R2_BUCKET_NAME=deneeuimages
CLOUDFLARE_R2_PUBLIC_URL=https://pub-xxx.r2.dev

# ─────────────────────────────────────────────────────────────
# Resend — emaile transakcyjne
# ─────────────────────────────────────────────────────────────
# 1. Załóż konto na https://resend.com
# 2. API Keys → utwórz nowy klucz.
# 3. Domenę nadawcy zweryfikuj w Resend → Domains, zanim wyślesz do realnych skrzynek.
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@deneeu.pl
RESEND_FROM_NAME=Deneeu

# Numer konta bankowego Deneeu wyświetlany na fakturach w mailu.
DENEEU_BANK_ACCOUNT="PL00 0000 0000 0000 0000 0000 0000"

# ─────────────────────────────────────────────────────────────
# Stripe Connect — automatyczne wypłaty influencerów
# ─────────────────────────────────────────────────────────────
# 1. Załóż konto na https://dashboard.stripe.com i włącz Stripe Connect.
# 2. Developers → API keys → Secret key.
# 3. Developers → Webhooks → dodaj endpoint /api/stripe/webhook,
#    zaznacz zdarzenia: account.updated, transfer.created, transfer.reversed.
#    Signing secret trafia do STRIPE_WEBHOOK_SECRET.
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ─────────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────────
# Publiczny URL aplikacji — używany do budowania linków w mailach i przy
# callbackach Stripe onboarding. Lokalnie: http://localhost:3000
NEXT_PUBLIC_APP_URL=https://www.deneeu.pl

# Upstash Redis — współdzielony licznik rate limitingu (opcjonalne).
# Bez tych zmiennych limiter działa w pamięci procesu: poprawnie na jednej
# instancji, ale na serverless każda instancja liczy osobno.
UPSTASH_REDIS_REST_URL=…
UPSTASH_REDIS_REST_TOKEN=…

# Dane wystawcy faktur. WYMAGANE do wystawiania faktur — bez nich
# generateInvoiceAction odmawia, zamiast wystawić dokument z fikcyjnym NIP-em.
DENEEU_ISSUER_NAME="Deneeu Sp. z o.o."
DENEEU_ISSUER_NIP=…
DENEEU_ISSUER_ADDRESS=…
DENEEU_ISSUER_CITY=…
DENEEU_ISSUER_POSTAL_CODE=…

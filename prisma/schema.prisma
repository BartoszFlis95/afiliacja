generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  BRAND
  INFLUENCER
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum ConversionStatus {
  PENDING
  CONFIRMED
  REJECTED
  PAID
}

enum CommissionStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  REJECTED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  CANCELLED
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id         String   @id @default(cuid())
  identifier String
  token      String   @unique @default(cuid())
  expires    DateTime
  createdAt  DateTime @default(now())

  @@unique([identifier, token])
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  role          Role      @default(INFLUENCER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts          Account[]
  sessions          Session[]
  brandProfile      BrandProfile?
  influencerProfile InfluencerProfile?
}

model BrandProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  companyName    String
  industry       String?
  website        String?
  logoUrl        String?
  description    String?
  isVerified     Boolean  @default(false)
  apiKey         String   @unique @default(cuid())
  webhookSecret  String   @default(cuid())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  products    Product[]
  commissions Commission[]
  invoices    Invoice[]
}

model InfluencerProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  displayName    String
  bio            String?
  avatarUrl      String?
  website        String?
  instagramUrl   String?
  youtubeUrl     String?
  tiktokUrl      String?
  followersCount Int?
  isVerified     Boolean  @default(false)

  bankAccountName  String?
  bankAccountIban  String?
  bankAccountBank  String?
  bankSwift        String?
  paypalEmail      String?
  preferredPayout  String?
  phone            String?
  city             String?
  country          String?

  stripeAccountId      String?
  stripeAccountStatus  String?
  stripeOnboardingDone Boolean  @default(false)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  affiliateLinks AffiliateLink[]
  commissions    Commission[]
  payouts        Payout[]
}

model Product {
  id             String        @id @default(cuid())
  brandProfileId String
  name           String
  description    String?
  imageUrl       String?
  category       String?
  price                    Decimal?
  commissionRate           Float
  influencerCommissionRate Float    @default(0)
  productUrl               String   @default("")
  slug           String        @unique
  status         ProductStatus @default(DRAFT)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  brandProfile   BrandProfile    @relation(fields: [brandProfileId], references: [id], onDelete: Cascade)
  affiliateLinks AffiliateLink[]
  commissions    Commission[]
}

model AffiliateLink {
  id                  String   @id @default(cuid())
  influencerProfileId String
  productId           String
  code                String   @unique
  totalClicks         Int      @default(0)
  totalConversions    Int      @default(0)
  totalEarnings       Decimal  @default(0)
  createdAt           DateTime @default(now())

  influencerProfile InfluencerProfile @relation(fields: [influencerProfileId], references: [id], onDelete: Cascade)
  product           Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  clicks            Click[]
  conversions       Conversion[]
  commissions       Commission[]

  @@unique([influencerProfileId, productId])
}

model Click {
  id              String   @id @default(cuid())
  affiliateLinkId String
  ip              String?
  userAgent       String?
  referer         String?
  isFraud         Boolean  @default(false)
  fraudReason     String?
  createdAt       DateTime @default(now())

  affiliateLink AffiliateLink @relation(fields: [affiliateLinkId], references: [id], onDelete: Cascade)
}

model Conversion {
  id                   String           @id @default(cuid())
  affiliateLinkId      String
  orderId              String?          @unique
  customerEmail        String?
  amount               Decimal
  commission           Decimal
  influencerCommission Decimal          @default(0)
  platformCommission   Decimal          @default(0)
  status               ConversionStatus @default(PENDING)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  affiliateLink AffiliateLink @relation(fields: [affiliateLinkId], references: [id], onDelete: Cascade)
}

model Commission {
  id                String           @id @default(cuid())
  influencerId      String
  brandId           String
  productId         String
  affiliateLinkId   String
  orderId           String?
  orderValue        Decimal
  commissionPercent Float
  commissionAmount  Decimal
  status            CommissionStatus @default(PENDING)
  ipAddress         String?
  isSuspicious      Boolean          @default(false)
  suspiciousReason  String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  influencer    InfluencerProfile @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  brand         BrandProfile      @relation(fields: [brandId], references: [id], onDelete: Cascade)
  product       Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  affiliateLink AffiliateLink     @relation(fields: [affiliateLinkId], references: [id], onDelete: Cascade)
  payout        Payout?
}

model Payout {
  id           String       @id @default(cuid())
  influencerId String
  commissionId String       @unique
  amount       Decimal
  bankAccount  String?
  status       PayoutStatus @default(PENDING)
  requestedAt  DateTime     @default(now())
  processedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  stripeTransferId String?
  payoutMethod     String?

  influencer InfluencerProfile @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  commission Commission        @relation(fields: [commissionId], references: [id], onDelete: Cascade)
}

model Invoice {
  id              String        @id @default(cuid())
  invoiceNumber   String        @unique
  brandId         String

  periodFrom      DateTime
  periodTo        DateTime

  netAmount        Decimal       @db.Decimal(10, 2)
  vatRate          Decimal       @db.Decimal(5, 2)  @default(23)
  vatAmount        Decimal       @db.Decimal(10, 2)
  grossAmount      Decimal       @db.Decimal(10, 2)

  brandCompanyName String
  brandNip         String?
  brandAddress     String?
  brandCity        String?
  brandPostalCode  String?
  brandEmail       String

  issuerName       String        @default("Deneeu Sp. z o.o.")
  issuerNip        String        @default("0000000000")
  issuerAddress    String        @default("ul. Przykładowa 1")
  issuerCity       String        @default("Warszawa")
  issuerPostalCode String        @default("00-001")

  status          InvoiceStatus  @default(DRAFT)
  issuedAt        DateTime       @default(now())
  dueDate         DateTime
  paidAt          DateTime?

  items           Json
  notes           String?

  paidViaStripe    Boolean       @default(false)
  payoutsTriggered Boolean       @default(false)

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  brand           BrandProfile   @relation(fields: [brandId], references: [id], onDelete: Cascade)
}